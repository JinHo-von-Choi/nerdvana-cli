  "components": {
    "schemas": {
      "User": {
        "type": "object",
        "required": [
          "name",
          "email"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "readOnly": true
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "admin",
              "member",
              "guest"
            ],
            "default": "member"
          }
        }
      },
      "Project": {
        "type": "object",
        "required": [
          "name",
          "owner_id"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "readOnly": true
          },
          "name": {
            "type": "string"
          },
          "owner_id": {
            "type": "integer"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "archived"
            ],
            "default": "active"
          }
        }
      },
      "Ticket": {
        "type": "object",
        "required": [
          "project_id",
          "title"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "readOnly": true
          },
          "project_id": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "doing",
              "done"
            ],
            "default": "open"
          },
          "assignee_id": {
            "type": "integer"
          }
        }
      },
      "Comment": {
        "type": "object",
        "required": [
          "ticket_id",
          "author_id",
          "body"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "readOnly": true
          },
          "ticket_id": {
            "type": "integer"
          },
          "author_id": {
            "type": "integer"
          },
          "body": {
            "type": "string"
          }
        }
      },
      "Label": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "readOnly": true
          },
          "name": {
            "type": "string"
          },
          "color": {
            "type": "string",
            "enum": [
              "gray",
              "red",
              "green",
              "blue"
            ],
            "default": "gray"
          }
        }
      },
      "Sprint": {
        "type": "object",
        "required": [
          "project_id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "readOnly": true
          },
          "project_id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "goal": {
            "type": "string",
            "default": ""
          }
        }
      }
    }
  }
