# NerdVana CLI Configuration
# Copy to ~/.nerdvana/config.yml or ./nerdvana.yml

model:
  # Provider: anthropic, openai, gemini, groq, openrouter, xai, ollama, vllm, deepseek, mistral, cohere, together, zai, featherless, xiaomi_mimo, moonshot, dashscope, minimax, perplexity, fireworks, cerebras
  # Leave empty to auto-detect from model name
  provider: ""

  # Model name — provider auto-detected from prefix
  # Anthropic: claude-sonnet-5-5, claude-opus-5-5
  # OpenAI: gpt-4.1, gpt-4o, o3
  # Gemini: gemini-2.5-flash, gemini-2.5-pro
  # Groq: llama-3.3-70b-versatile, llama-3.1-8b-instant
  # Ollama: qwen3, llama3:70b, gemma2:9b
  # DeepSeek: deepseek-flash, deepseek-v4-pro
  # Mistral: mistral-medium-3-5, mistral-large-latest, codestral-latest
  # Featherless: featherless-llama-3-70b
  # Xiaomi MiMo: mimo-v2.5-pro, mimo-v2-omni, mimo-v2-flash
  # Moonshot AI (Kimi): kimi-k3 (kimi-k2-instruct, kimi-latest, moonshot-v1-* are retired upstream)
  # Alibaba DashScope (Qwen): qwen3-coder-plus, qwen-max, qwen-turbo
  # MiniMax: MiniMax-M2, abab6.5s-chat
  # Perplexity: sonar-pro, sonar-reasoning-pro
  # Fireworks AI: accounts/fireworks/models/llama-v3p3-70b-instruct
  # Cerebras: llama-3.3-70b, qwen-3-32b
  model: claude-sonnet-5-5

  # Leave empty to use provider's env var
  # Anthropic: ANTHROPIC_API_KEY
  # OpenAI: OPENAI_API_KEY
  # Gemini: GEMINI_API_KEY
  # Groq: GROQ_API_KEY
  # Ollama Cloud: OLLAMA_API_KEY (not needed for local)
  # DeepSeek: DEEPSEEK_API_KEY
  # Mistral: MISTRAL_API_KEY
  # Featherless: FEATHERLESS_API_KEY
  # Xiaomi MiMo: MIMO_API_KEY or XIAOMI_API_KEY
  # Moonshot AI (Kimi): MOONSHOT_API_KEY or KIMI_API_KEY
  # Alibaba DashScope (Qwen): DASHSCOPE_API_KEY or ALIBABA_API_KEY
  # ZAI (GLM): ZHIPUAI_API_KEY
  # Cohere: CO_API_KEY
  # Together AI: TOGETHER_API_KEY
  # OpenRouter: OPENROUTER_API_KEY
  # xAI (Grok): XAI_API_KEY
  # MiniMax: MINIMAX_API_KEY
  # Perplexity: PERPLEXITY_API_KEY or PPLX_API_KEY
  # Fireworks AI: FIREWORKS_API_KEY
  # Cerebras: CEREBRAS_API_KEY
  # etc.
  api_key: ""

  # Override API endpoint (for custom proxies, local servers)
  # Ollama local: http://localhost:11434/v1
  # Ollama cloud: https://ollama.com/v1
  # Ollama self-hosted: http://192.168.1.100:11434/v1
  base_url: ""

  # Max tokens per response
  max_tokens: 8192

  # Temperature (0.0 = deterministic, 1.0 = creative)
  temperature: 1.0

  # Fallback models tried in order on 429/529/503/timeout errors
  fallback_models: []

  # Turns on thinking for Anthropic models that make it optional (the ultrawork/ulw keyword
  # turns it on per prompt). Current Claude 5 models think by default and ignore this switch.
  extended_thinking: false

  # Token budget for thinking on models that take a manual budget (Haiku 4.5 and the other
  # pre-4.6 models). Adaptive models decide for themselves and ignore it.
  thinking_budget: 8192

  # Show thinking: asks Anthropic models for thinking summaries and renders <think>...</think>
  # blocks as a dim italic prefix above the answer.
  show_thinking: true

  # How hard the model reasons. Anthropic models: low, medium, high, xhigh or max (which of them a model
  # accepts differs); OpenAI and Gemini take their own words. Empty keeps the provider's default.
  reasoning_effort: ""

  # Which OpenAI API OpenAI-compatible providers speak: auto (Responses on OpenAI's own endpoint,
  # Chat Completions elsewhere), chat, or responses.
  openai_api: auto

  # Which Gemini API the gemini provider speaks: generate_content, interactions (stateless,
  # store: false), or auto (picks interactions).
  gemini_api: generate_content
  # Anthropic only. Server-side tool search for MCP tools: off, bm25 or regex.
  anthropic_tool_search: "off"

  # Anthropic only. Server-side compaction (beta) on the models that support it: off or on.
  anthropic_compaction: "off"

  # Anthropic only. Registers Anthropic's memory tool (/memories files kept per project in the data root).
  anthropic_memory_tool: false

# Per-provider last-used model. Updated automatically by /provider and /model.
# Keys are provider names (anthropic, openai, dashscope, ...); values are model IDs.
model_history: {}

permissions:
  mode: default
  always_allow:
    - "FileRead"
    - "Glob"
    - "Grep"
  always_deny: []
  gate_untrusted_sources: true

session:
  persist: true
  max_turns: 200
  max_context_tokens: 180000
  compact_threshold: 0.8
  # Circuit breaker: max consecutive AI compaction failures before fallback
  compact_max_failures: 3
  # Replace old read-type tool output with a placeholder, in batches, before compaction
  observation_masking: false
  # Most recent tool results that are never cleared
  mask_keep_last: 6
  # Clearable old output (estimated tokens) that must pile up before one batch clears it
  mask_trigger_tokens: 20000
  report_bash_changes: false
  # Spawn a Plan subagent on complex prompts before execution
  planning_gate: false
  # Tell the model once when this many edits in a row to one file all failed, or this many turns
  # in a row only read and searched (counted as no_progress); 0 turns a check off. See docs/goals.md.
  no_progress_failed_edits: 3
  no_progress_read_turns: 12
  # Show the live ActivityIndicator (idle/thinking/tool/streaming/waiting).
  show_activity: true
  # Default runtime context profile name
  default_context: standalone
  # Default runtime mode name (interactive, planning, etc.)
  default_mode: interactive
  # Check GitHub Releases for a newer version on startup (cached 24h).
  # Also disabled by --no-update-check or NERDVANA_NO_UPDATE_CHECK=1.
  update_check: true

checkpoint:
  enabled: true
  per_session_max: 50

telemetry:
  otel:
    # OpenTelemetry traces (needs: pip install 'nerdvana-cli[otel]'). See docs/observability.md.
    enabled: false
    # OTLP/HTTP collector base URL; empty = the OTEL_EXPORTER_OTLP_ENDPOINT environment variable
    endpoint: ""
    service_name: nerdvana-cli
    # Also record the conversation, tool arguments and tool results on the spans (secrets masked)
    capture_content: false

hooks:
  # Run <cwd>/.nerdvana/hooks/*.py and load project skills (<cwd>/.agents/skills,
  # <cwd>/.nerdvana/skills). Opting in is not sufficient on its own: each file must
  # also match an approved digest in ~/.nerdvana/trusted_hooks.json.
  # See docs/hooks.md and docs/skills.md.
  allow_project_hooks: false

agents:
  # Category -> model for sub-agents, "model" or "provider:model". An Agent call, a Swarm
  # task or an agent definition that names a category runs on the mapped model.
  categories: {}
  #  quick: claude-haiku-4-5-20251001

goal:
  # A goal (nerdvana run --verify, /goal) is done when its command exits with status 0. See docs/goals.md.
  verify_timeout: 300
  max_attempts: 5
  output_tail_chars: 4000
  # Without a goal, run the detected test command (pytest, npm test, cargo test, go test) before a
  # run that changed files is accepted as finished. See docs/goals.md.
  auto_verify: false

memory:
  # true: memories the agent proposes wait in an inbox until you approve them
  # (nerdvana memory inbox, nerdvana memory approve <id>). See docs/memory.md.
  review: false

sandbox:
  # off | auto | require: confine what the Bash tool can write with the operating system
  # (Linux Landlock). See docs/sandbox.md.
  mode: off
  # false also refuses TCP connections and binds from the command (Linux 6.7 and later);
  # allowlist lets it reach only a local proxy that passes allowed_domains
  network: true
  # Hosts the proxy lets through when network is allowlist: a name, *.suffix or an IP address
  allowed_domains: []
  # Writable in addition to the project directory and the temporary directories
  write_paths: []

secrets:
  # domain (or *.suffix) -> environment variable the egress proxy adds to plain HTTP requests for it
  # ("VARIABLE" = Authorization: Bearer, "Header-Name:VARIABLE" = that header). See docs/sandbox.md.
  proxy_credentials: {}

# Register ListQueryableProjects / RegisterExternalProject / QueryExternalProject.
# They hand a registered directory to a read-capable subprocess, so the family
# stays unregistered until this is turned on.
external_projects_enabled: false

parism:
  # Use Parism for structured shell output (requires Node.js)
  enabled: true
  # Custom prism.config.json path (empty = default whitelist)
  config_path: ""
  # Default output format: "json" (structured) or "compact" (token-efficient)
  format: json
  # Fallback to raw Bash when Parism is unavailable
  fallback_to_bash: true

# Web search: the WebSearch tool reads BRAVE_API_KEY from the environment and
# raises at call time when it is unset. There is no config key for it.
